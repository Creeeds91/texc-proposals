# TEXC Proposals — environment. Set these in Vercel (Production and Preview);
# never commit real values. `node scripts/demo/local-app.mjs` sets its own.

# Supabase (Sydney). The SECRET key goes server-side only, in the apikey header.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# 32 random bytes, base64. Seals each proposal's passphrase at rest.
# Losing it means every passphrase must be rotated. Keep a copy offline.
VAULT_KEY=

# Keys the hash of a caller's IP in rate limits and logs. Any long random string.
IP_HASH_KEY=

# Where links point (no trailing slash), e.g. https://proposals.texc.au (Q11/C27).
PUBLIC_BASE_URL=

# Accounts. Supers (Brand in Black) are computed from this list, never stored.
ACCOUNT_SUPERS=
# Work domains that may request access. Defaults to texc.au.
ACCOUNT_DOMAINS=texc.au

# Email (SMTP2GO). The sender needs SPF/DKIM on its domain first (C27).
SMTP2GO_API_KEY=
MAIL_FROM="TEXC Proposals <proposals@texc.au>"
# Who hears when a client first opens a proposal, accepts it, or asks for changes.
NOTIFY_TO=
# Also sent every acceptance (for example a records mailbox). Optional.
NOTIFY_BCC=

# Preview deployments only: also serve /demo and its fictional fixture.
DEMO_PUBLIC=
